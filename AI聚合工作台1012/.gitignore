# ============================================================
#  多 AI 聚合工作台 — 项目级忽略规则
#  （仓库根 .gitignore 已排除 node_modules / .env / 浏览器登录态）
# ============================================================

# 依赖与本地 npm 缓存
node_modules/
.npm-cache/

# 运行期数据：SQLite 库、上传的图片
data/

# 临时目录：截图脚本的浏览器 profile、临时帧
.tmp/

# 构建产物
dist/

# 日志
*.log
