{
  "name": "dsh-launcher",
  "productName": "DeepSeek Harness Launcher",
  "version": "1.0.0",
  "description": "One-click desktop launcher for the DeepSeek Harness (dsh) Web UI",
  "author": "DeepSeek Harness Launcher",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "node scripts/make-icon.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "node --test \"tests/server-manager.test.js\" \"tests/kill-tree.test.js\"",
    "smoke": "electron . --smoke-test",
    "dist": "npm run icon && electron-builder",
    "dist:win": "npm run icon && electron-builder --win",
    "dist:mac": "npm run icon && electron-builder --mac",
    "dist:linux": "npm run icon && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  }
}
